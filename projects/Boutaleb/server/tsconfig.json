{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "incremental": true,
        "skipLibCheck": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "types": ["node", "vitest/globals"],
        "customConditions": ["boutaleb-node"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
