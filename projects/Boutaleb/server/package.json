{
    "name": "boutaleb-server",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter @repo/schemas build && infisical run -- nest start --watch --exec \"node --conditions=boutaleb-node\"",
        "start": "node --conditions=boutaleb-node dist/main.js",
        "build": "pnpm --filter @repo/schemas build && nest build",
        "typecheck": "pnpm --filter @repo/schemas build && tsc --noEmit",
        "test": "vitest run",
        "seed:owner": "infisical run -- node --conditions=boutaleb-node dist/cli/seed-owner.js"
    },
    "dependencies": {
        "@casl/ability": "7.0.2",
        "@clerk/backend": "3.23.1",
        "@nestjs/common": "12.3.2",
        "@nestjs/config": "12.0.1",
        "@nestjs/core": "12.3.2",
        "@nestjs/mongoose": "12.0.0",
        "@nestjs/platform-express": "12.3.2",
        "@nestjs/terminus": "12.1.0",
        "@repo/schemas": "workspace:*",
        "helmet": "8.3.0",
        "mongoose": "9.12.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@nestjs/cli": "12.0.8",
        "@nestjs/testing": "12.3.2",
        "@swc/core": "1.16.13",
        "@types/express": "5.0.6",
        "@types/node": "25.0.9",
        "@types/supertest": "7.2.1",
        "mongodb-memory-server": "11.3.0",
        "supertest": "7.3.1",
        "typescript": "catalog:",
        "unplugin-swc": "2.0.0",
        "vitest": "5.0.3"
    },
    "config": {
        "mongodbMemoryServer": {
            "version": "8.0.32"
        }
    }
}
