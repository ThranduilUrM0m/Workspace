# Loaded by `pnpm jobs:dev` (trigger dev --env-file). Without it, the
# Trigger.dev CLI reads .env and passes its values to the worker, which
# pointed the jobs at a stale remote database. No secrets here: secrets
# come from Infisical. Local services only.
MONGODB_URI=mongodb://127.0.0.1:27017/boutaleb
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
