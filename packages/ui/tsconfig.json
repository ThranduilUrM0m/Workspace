{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "esnext"],
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}
