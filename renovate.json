{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", ":semanticCommits"],
  "labels": ["dependencies"],
  "timezone": "Africa/Casablanca",
  "prConcurrentLimit": 10,
  "ignorePaths": [
    "**/node_modules/**",
    "projects/Maxconfort/**",
    "projects/Qasidaty/**",
    "projects/Risala/**"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "prPriority": 10
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Nest moves as one",
      "matchPackageNames": ["@nestjs/**"],
      "groupName": "nest"
    },
    {
      "description": "Next moves with React",
      "matchPackageNames": ["next", "@next/**", "react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "next and react"
    },
    {
      "description": "TipTap/ProseMirror must stay on one exact version (HANDOFF §14)",
      "matchPackageNames": ["@tiptap/**"],
      "groupName": "tiptap"
    },
    {
      "description": "Dev-only patch and minor updates merge themselves once CI is green",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Every major waits for the developer, one PR each",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"],
      "dependencyDashboardApproval": false
    }
  ]
}
